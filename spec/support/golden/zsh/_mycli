#compdef mycli

# Generated by dry-cli-autocomplete. Regenerate after changing commands.

_mycli_completions() {
  local curcontext="$curcontext" state line ret=1
  local -a commands
  typeset -A opt_args

  local path_key="" i=2
  while (( i < CURRENT )); do
    case "$path_key:${words[i]}" in
      (':version') path_key='version' ;;
      (':deploy') path_key='deploy' ;;
      (':db') path_key='db' ;;
      ('db:migrate') path_key='db migrate' ;;
      (*) break ;;
    esac
    (( i += 1 ))
  done

  case "$path_key" in
    ('')
      commands=(
        'version:Print the version'
        'deploy:Deploy the application'
        'db:Show pending migrations'
      )
      _describe -t commands 'command' commands && ret=0
      ;;
    ('version')
      _arguments -s \
        '--format[Output format]:format:(json plain)' && ret=0
      ;;
    ('deploy')
      _arguments -s \
        '--force[Skip confirmation]' \
        '-f[Skip confirmation]' \
        '*:Target environment:(staging production)' && ret=0
      ;;
    ('db')
      _arguments -s \
        '--verbose[Print full history]' && ret=0
      commands=(
        'migrate:Run pending migrations'
      )
      _describe -t commands 'db command' commands && ret=0
      ;;
    ('db migrate')
      _arguments -s \
        '*:Migration file:_files' && ret=0
      ;;
  esac

  return ret
}

_mycli_completions "$@"
