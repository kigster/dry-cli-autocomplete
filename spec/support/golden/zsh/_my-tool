#compdef my-tool

# Generated by dry-cli-autocomplete. Regenerate after changing commands.

_my_tool_completions() {
  local curcontext="$curcontext" state line ret=1
  local -a commands
  typeset -A opt_args

  local path_key="" i=2
  while (( i < CURRENT )); do
    case "$path_key:${words[i]}" in
      (':status') path_key='status' ;;
      (*) break ;;
    esac
    (( i += 1 ))
  done

  case "$path_key" in
    ('')
      commands=(
        'status:'
      )
      _describe -t commands 'command' commands && ret=0
      ;;
  esac

  return ret
}

_my_tool_completions "$@"
