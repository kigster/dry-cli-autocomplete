#compdef mycli

# Generated by dry-cli-autocomplete in dynamic mode: every TAB asks mycli.

_mycli_complete_dynamic() {
  local line found=1
  local -a candidates
  for line in ${(f)"$("${words[1]}" __complete -- "${(@)words[2,CURRENT]}" 2>/dev/null)"}; do
    if [[ "$line" == ":files" ]]; then
      _files && found=0
    else
      candidates+=("$line")
    fi
  done
  if (( ${#candidates} )); then
    compadd -a candidates && found=0
  fi
  return $found
}

_mycli() {
  _mycli_complete_dynamic
}

if [ "$funcstack[1]" = "_mycli" ]; then
  _mycli "$@"
else
  compdef _mycli mycli
fi
